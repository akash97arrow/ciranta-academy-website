# Use these as environment variables in the PHP hosting environment.
# This project does not load .env files automatically.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
CONTACT_FROM_EMAIL=website@example.com
CONTACT_FROM_NAME=Ciranta Academy
CONTACT_TO_EMAIL=recipient@example.com